<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.Region?>

<VBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml/1" 
      fx:controller="showroom.controller.VehicleDetailsController" 
      spacing="0" styleClass="details-container" prefWidth="900" prefHeight="650">
    
    <ScrollPane fitToWidth="true" fitToHeight="true" VBox.vgrow="ALWAYS" 
                style="-fx-background: #1E1E1E; -fx-background-color: #1E1E1E;">
        <HBox spacing="0">
            <!-- Left Side: Image Gallery -->
            <VBox spacing="15" prefWidth="420" alignment="TOP_CENTER" styleClass="image-gallery-bg">
                <padding>
                    <Insets top="20" right="20" bottom="20" left="20"/>
                </padding>
                
                <StackPane styleClass="main-image-placeholder" style="-fx-background-color: #2A2A2A; -fx-background-radius: 10;">
                    <Label fx:id="noImageLabel" text="No picture available" textFill="GRAY" visible="false" />
                    <ImageView fx:id="mainImageView" fitWidth="380" fitHeight="300" pickOnBounds="true" preserveRatio="true" />
                </StackPane>
                
                <Label text="Gallery" style="-fx-text-fill: #888; -fx-font-size: 12px; -fx-font-weight: bold;"/>
                <ScrollPane fitToWidth="true" maxHeight="120" style="-fx-background: transparent; -fx-background-color: transparent;">
                    <HBox fx:id="thumbnailContainer" spacing="10" alignment="CENTER_LEFT" />
                </ScrollPane>
            </VBox>
            
            <!-- Right Side: Details -->
            <VBox spacing="20" HBox.hgrow="ALWAYS" style="-fx-padding: 20 30 20 30;">
                <!-- Header Section -->
                <VBox spacing="8" alignment="TOP_LEFT">
                    <HBox alignment="CENTER_LEFT" spacing="15">
                        <Label fx:id="statusLabel" text="STATUS" style="-fx-padding: 5 12; -fx-background-radius: 5;"/>
                        <Region HBox.hgrow="ALWAYS" />
                        <Label fx:id="typeLabel" text="VEHICLE" textFill="#BB86FC" 
                               style="-fx-font-weight: bold; -fx-font-size: 13px; -fx-padding: 5 12; -fx-background-color: #2D2D2D; -fx-background-radius: 5;" />
                    </HBox>
                    <Label fx:id="titleText" text="Brand Model" styleClass="details-title" 
                           wrapText="true" style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #FFFFFF;"/>
                    <Label fx:id="yearText" text="2024" styleClass="details-year" 
                           style="-fx-font-size: 18px; -fx-text-fill: #888;"/>
                </VBox>
                
                <Separator style="-fx-opacity: 0.2;" />
                
                <!-- Price & Basic Info Section -->
                <VBox spacing="12" style="-fx-background-color: #252525; -fx-padding: 20; -fx-background-radius: 10;">
                    <Label text="Pricing & Information" 
                           style="-fx-text-fill: #BB86FC; -fx-font-weight: bold; -fx-font-size: 14px;" />
                    
                    <GridPane hgap="20" vgap="12">
                        <columnConstraints>
                            <ColumnConstraints minWidth="100" prefWidth="100"/>
                            <ColumnConstraints hgrow="ALWAYS"/>
                        </columnConstraints>
                        
                        <Label text="Price:" GridPane.columnIndex="0" GridPane.rowIndex="0"
                               style="-fx-text-fill: #999; -fx-font-size: 13px;"/>
                        <Label fx:id="priceLabel" text="$0.00" GridPane.columnIndex="1" GridPane.rowIndex="0"
                               style="-fx-text-fill: #4CAF50; -fx-font-weight: bold; -fx-font-size: 20px;" />
                        
                        <Label text="Color:" GridPane.columnIndex="0" GridPane.rowIndex="1"
                               style="-fx-text-fill: #999; -fx-font-size: 13px;"/>
                        <Label fx:id="colorLabel" text="Color" GridPane.columnIndex="1" GridPane.rowIndex="1"
                               style="-fx-text-fill: #EEE; -fx-font-size: 13px;"/>
                        
                        <Label text="Vehicle ID:" GridPane.columnIndex="0" GridPane.rowIndex="2"
                               style="-fx-text-fill: #999; -fx-font-size: 13px;"/>
                        <Label fx:id="idLabel" text="#0" GridPane.columnIndex="1" GridPane.rowIndex="2"
                               style="-fx-text-fill: #EEE; -fx-font-size: 13px;"/>
                    </GridPane>
                </VBox>
                
                <!-- Vehicle Condition Section (for Cars) -->
                <VBox fx:id="conditionSection" spacing="12" 
                      style="-fx-background-color: #252525; -fx-padding: 20; -fx-background-radius: 10;" 
                      managed="false" visible="false">
                    <Label text="Vehicle Condition" 
                           style="-fx-text-fill: #03DAC6; -fx-font-weight: bold; -fx-font-size: 14px;" />
                    <VBox fx:id="conditionContainer" spacing="8"/>
                </VBox>
                
                <!-- Technical Specifications Section -->
                <VBox spacing="12" style="-fx-background-color: #252525; -fx-padding: 20; -fx-background-radius: 10;">
                    <Label text="Technical Specifications" 
                           style="-fx-text-fill: #BB86FC; -fx-font-weight: bold; -fx-font-size: 14px;" />
                    <VBox fx:id="specificationsContainer" spacing="10" />
                </VBox>
                
                <!-- Action Buttons -->
                <HBox spacing="15" alignment="CENTER_RIGHT" style="-fx-padding: 10 0 0 0;">
                    <Button text="Edit Vehicle" onAction="#handleEdit" 
                            styleClass="button-primary" prefWidth="130" prefHeight="35"/>
                    <Button text="Close" onAction="#handleClose" 
                            styleClass="button-secondary" prefWidth="100" prefHeight="35"/>
                </HBox>
            </VBox>
        </HBox>
    </ScrollPane>
</VBox>
